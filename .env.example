# Tuna stack variables. ALL OPTIONAL: the easy way is to leave these empty and set everything in
# the app (first-run setup, then Settings → Connections). Anything saved in the app takes over.
# For local development against real services, copy to server/.env (but develop against the
# mock: npm run dev:mock).
#
# Where to find the keys:
#   Lidarr   → Settings → General → Security → API Key
#   Last.fm  → last.fm/api/account/create (free; similar artists you don't have yet)

TUNA_IMAGE=ghcr.io/ravifrancesco/tuna:latest
TZ=Etc/UTC
MUSIC_DIR=/srv/music
DOWNLOADS_DIR=/srv/downloads

NAVIDROME_URL=
LIDARR_URL=
LIDARR_API_KEY=
LASTFM_API_KEY=

# Optional: the Lidarr quality profile Get uses (by name; the first one otherwise).
LIDARR_QUALITY_PROFILE=
# Look up lyrics on LRCLIB when a song has none (default true).
LYRICS_ONLINE=true
LOG_LEVEL=info
